<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/fondo_base" android:orientation="vertical"
    android:paddingHorizontal="32dp">
    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="2"/>
    <TextView android:id="@+id/tvLogo" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
        android:textSize="40sp" android:textStyle="bold" android:textColor="@color/texto_claro"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:layout_marginTop="6dp"
        android:text="@string/tagline" android:textSize="11sp"
        android:textColor="@color/texto_secund" android:letterSpacing="0.22"/>
    <FrameLayout android:layout_width="110dp" android:layout_height="110dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="48dp"
        android:layout_marginBottom="48dp">
        <View android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/bg_shield_glow"/>
        <ImageView android:layout_width="50dp" android:layout_height="50dp"
            android:layout_gravity="center" android:src="@drawable/ic_shield"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:text="@string/desc_bienvenida"
        android:textSize="15sp" android:textColor="@color/texto_secund"
        android:lineSpacingMultiplier="1.65"/>
    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="2"/>
    <TextView android:id="@+id/btnComenzar" android:layout_width="match_parent"
        android:layout_height="54dp" android:background="@drawable/bg_gradient_panico"
        android:gravity="center" android:text="@string/comenzar"
        android:textColor="@color/blanco" android:textSize="15sp"
        android:textStyle="bold" android:letterSpacing="0.1"/>
    <TextView android:id="@+id/tvLoginLink" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="22dp"
        android:gravity="center" android:textSize="14sp"
        android:textColor="@color/texto_secund" android:paddingBottom="8dp"
        android:text="@string/ya_tienes_cuenta"/>
    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
