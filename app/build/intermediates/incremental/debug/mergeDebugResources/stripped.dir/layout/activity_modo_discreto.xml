<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/fondo_base" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingHorizontal="20dp" android:paddingTop="20dp">
        <TextView android:id="@+id/tvBack" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="←"
            android:textColor="@color/texto_claro" android:textSize="22sp" android:paddingEnd="16dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/modo_discreto" android:textColor="@color/texto_claro"
            android:textSize="26sp" android:textStyle="bold"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="20dp"
            android:paddingTop="24dp" android:paddingBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_discreto_hero" android:gravity="center"
                android:orientation="vertical" android:padding="24dp">
                <TextView android:layout_width="60dp" android:layout_height="60dp"
                    android:background="@drawable/bg_card_border" android:gravity="center"
                    android:text="🛡" android:textSize="28sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="@string/activa_sin_abrir"
                    android:textColor="@color/texto_claro" android:textSize="18sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:gravity="center"
                    android:text="@string/gestos_secretos" android:textColor="@color/texto_secund"
                    android:textSize="13sp" android:lineSpacingMultiplier="1.5"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:background="@drawable/bg_card_border"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingHorizontal="16dp" android:paddingVertical="14dp">
                <TextView android:layout_width="22dp" android:layout_height="22dp"
                    android:text="🔊" android:textSize="16sp" android:gravity="center"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/boton_volumen" android:textColor="@color/texto_claro"
                        android:textSize="15sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/boton_volumen_sub" android:textColor="@color/texto_secund" android:textSize="13sp"/>
                </LinearLayout>
                <Switch android:id="@+id/swVolumen" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:checked="true"
                    android:thumbTint="@color/blanco" android:trackTint="@color/panico"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="@drawable/bg_card_border"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingHorizontal="16dp" android:paddingVertical="14dp">
                <TextView android:layout_width="22dp" android:layout_height="22dp"
                    android:text="📱" android:textSize="16sp" android:gravity="center"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/agitar" android:textColor="@color/texto_claro"
                        android:textSize="15sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/agitar_sub" android:textColor="@color/texto_secund" android:textSize="13sp"/>
                </LinearLayout>
                <Switch android:id="@+id/swAgitar" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:checked="true"
                    android:thumbTint="@color/blanco" android:trackTint="@color/panico"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="@drawable/bg_card_border"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingHorizontal="16dp" android:paddingVertical="14dp">
                <TextView android:layout_width="22dp" android:layout_height="22dp"
                    android:text="🔒" android:textSize="16sp" android:gravity="center"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/bloqueada" android:textColor="@color/texto_claro"
                        android:textSize="15sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/bloqueada_sub" android:textColor="@color/texto_secund" android:textSize="13sp"/>
                </LinearLayout>
                <Switch android:id="@+id/swBloqueada" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:checked="false"
                    android:thumbTint="@color/texto_secund" android:trackTint="@color/superficie"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:background="@drawable/bg_card"
                android:gravity="top" android:orientation="horizontal" android:padding="14dp">
                <TextView android:layout_width="18dp" android:layout_height="18dp"
                    android:text="ℹ" android:textColor="@color/aviso" android:textSize="14sp" android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:layout_weight="1"
                    android:text="@string/nota_discreta" android:textColor="@color/texto_secund"
                    android:textSize="12sp" android:lineSpacingMultiplier="1.5"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
