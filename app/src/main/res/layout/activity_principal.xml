<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/fondo_base" android:orientation="vertical"
    android:paddingHorizontal="20dp">

    <!-- HEADER: Hola + nombre + avatar + cerrar sesión -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Nombre -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/hola" android:textColor="@color/texto_secund"
                android:textSize="14sp"/>
            <TextView android:id="@+id/tvNombreUsuario" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/texto_claro"
                android:textSize="24sp" android:textStyle="bold"/>
        </LinearLayout>

        <!-- Columna derecha: avatar + cerrar sesión -->
        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal">

            <TextView android:id="@+id/tvAvatar"
                android:layout_width="46dp" android:layout_height="46dp"
                android:background="@drawable/bg_shield_glow" android:gravity="center"
                android:textColor="@color/blanco" android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView android:id="@+id/tvCerrarSesion"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Salir"
                android:textColor="#B91C1C"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Espaciador -->
    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

    <!-- Botón de pánico -->
    <FrameLayout android:layout_width="230dp" android:layout_height="230dp"
        android:layout_gravity="center_horizontal">

        <View android:id="@+id/btnPanico"
            android:layout_width="210dp" android:layout_height="210dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_panic_circle"/>

        <ImageView
            android:layout_width="88dp" android:layout_height="88dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_shield"
            app:tint="@android:color/white"
            android:elevation="10dp"/>
    </FrameLayout>

    <!-- Texto principal -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="26dp" android:gravity="center"
        android:text="@string/presiona_alertar" android:textColor="@color/texto_claro"
        android:textSize="16sp" android:textStyle="bold" android:letterSpacing="0.1"/>

    <!-- Instrucción modo discreto -->
    <TextView android:id="@+id/tvInstruccion"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:gravity="center"
        android:text="@string/instruccion_discreta"
        android:textColor="@color/texto_secund" android:textSize="12sp"/>

    <!-- Espaciador -->
    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

    <!-- Botones de navegación -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/btnContactos"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:background="@drawable/bg_card_border"
            android:gravity="center" android:orientation="vertical"
            android:paddingVertical="14dp">
            <TextView android:layout_width="26dp" android:layout_height="26dp"
                android:text="👥" android:gravity="center" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/contactos"
                android:textColor="@color/texto_secund" android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/btnHistorial"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_card_border" android:gravity="center"
            android:orientation="vertical" android:paddingVertical="14dp">
            <TextView android:layout_width="26dp" android:layout_height="26dp"
                android:text="📋" android:gravity="center" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/historial"
                android:textColor="@color/texto_secund" android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/btnDiscreto"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:background="@drawable/bg_card_border"
            android:gravity="center" android:orientation="vertical"
            android:paddingVertical="14dp">
            <TextView android:layout_width="26dp" android:layout_height="26dp"
                android:text="🔕" android:gravity="center" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/discreto"
                android:textColor="@color/texto_secund" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Banner modo discreto -->
    <LinearLayout android:id="@+id/bannerDiscreto"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:layout_marginBottom="20dp"
        android:background="@drawable/bg_card_border" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">
        <TextView android:id="@+id/tvBannerIcon"
            android:layout_width="16dp" android:layout_height="16dp"
            android:text="🔊" android:textSize="12sp"/>
        <TextView android:id="@+id/tvBannerTexto"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:layout_weight="1"
            android:textSize="12sp" android:textColor="@color/texto_secund"/>
    </LinearLayout>

</LinearLayout>