<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LabelStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">#64748B</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="InputStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:textColor">#1E293B</item>
        <item name="android:textColorHint">#94A3B8</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
